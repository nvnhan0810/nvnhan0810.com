{
  "name": "identity-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "dev": "vite --host localhost --port 5174 --strictPort",
    "build": "npm run type-check && vite build",
    "type-check": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run test && npm run build",
    "start": "node server/index.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "test:server": "node tests/server-smoke.ts"
  },
  "dependencies": {
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "lucide-vue-next": "^0.575.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@types/node": "^24.13.4",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11",
    "@vue/tsconfig": "^0.9.1",
    "vitest": "^4.1.12",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^30.0.1",
    "prettier": "3.9.6"
  }
}
