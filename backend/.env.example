APP_ENV=local
APP_URL=http://localhost:8080

# Loaded once at startup from .env (or backend/.env); process env takes precedence.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=identity
DB_USERNAME=identity
DB_PASSWORD=CHANGE_ME

GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME

IDENTITY_KEY_ID=identity-2026-01
IDENTITY_PRIVATE_KEY_PATH=/run/secrets/identity/private.pem
IDENTITY_PUBLIC_KEY_PATH=/run/secrets/identity/public.pem
# Admin page origin only. Other browser origins come from enabled clients.domain in DB.
IDENTITY_CORS_ORIGIN=

# Callback registered by the Identity master-data command on first creation.
IDENTITY_REDIRECT_URI=http://localhost:5173/auth/callback

# Queue storage uses the same DB_* PostgreSQL database.
# Run migrations, then start one shared consumer: console queue:work.
# Async warning/error alerts use the backend:queue:telegram-logs queue.
TELEGRAM_LOG_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_LOG_LEVEL=warning

# Wallets scheduled reminders (uses TELEGRAM_BOT_TOKEN above; never sent from page requests)
WALLETS_WEB_ORIGIN=https://wallets.nvnhan0810.com

# Todo Pomodoro/Web Push; consumed by the shared console queue worker.
TODO_WEB_ORIGIN=http://localhost:5177
TODO_VAPID_PUBLIC_KEY=
TODO_VAPID_PRIVATE_KEY=
TODO_VAPID_SUBJECT=mailto:nguyenvannhan0810@gmail.com
