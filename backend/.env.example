APP_ENV=local
APP_URL=http://localhost:8080

# Loaded once at startup from .env (or backend/.env); process env takes precedence.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=identity
DB_USERNAME=identity
DB_PASSWORD=CHANGE_ME

GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME

IDENTITY_KEY_ID=identity-2026-01
IDENTITY_PRIVATE_KEY_PATH=/run/secrets/identity/private.pem
IDENTITY_PUBLIC_KEY_PATH=/run/secrets/identity/public.pem
# Admin page origin only. Other browser origins come from enabled clients.domain in DB.
IDENTITY_CORS_ORIGIN=

# Callback registered by the Identity master-data command on first creation.
IDENTITY_REDIRECT_URI=http://localhost:5174/auth/callback

# Redis transport for Apalis; use the Redis instance already provisioned.
REDIS_URL=redis://127.0.0.1:6379/0
# Required environment namespace; use prod in production. Keep API and worker identical.
REDIS_QUEUE_PREFIX=dev

# Async warning/error alerts. Uses <REDIS_QUEUE_PREFIX>:backend:queue:telegram-logs.
TELEGRAM_LOG_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_LOG_LEVEL=warning

# Wallets scheduled reminders (uses TELEGRAM_BOT_TOKEN above; never sent from page requests)
WALLETS_WEB_ORIGIN=https://wallets.nvnhan0810.com
