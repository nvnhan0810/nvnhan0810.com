APP_ENV=local
APP_URL=http://localhost:8080

# Loaded once at startup from .env (or backend/.env); process env takes precedence.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=identity
DB_USERNAME=identity
DB_PASSWORD=CHANGE_ME

GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME

IDENTITY_KEY_ID=identity-2026-01
IDENTITY_PRIVATE_KEY_PATH=/run/secrets/identity/private.pem
IDENTITY_PUBLIC_KEY_PATH=/run/secrets/identity/public.pem
# Admin page origin only. Other browser origins come from enabled clients.domain in DB.
IDENTITY_CORS_ORIGIN=

# Callback registered by the Identity master-data command on first creation.
IDENTITY_REDIRECT_URI=http://localhost:5174/auth/callback

# Optional Laravel vocabulary import (disabled HTTP trigger by default).
FOREIGN_IMPORT_ENABLED=false
FOREIGN_CONSOLE_PATH=/usr/local/bin/console
FOREIGN_IMPORT_SOURCE_DB_HOST=127.0.0.1
FOREIGN_IMPORT_SOURCE_DB_PORT=5432
FOREIGN_IMPORT_SOURCE_DB_NAME=foreign_legacy
FOREIGN_IMPORT_SOURCE_DB_USERNAME=foreign_import_readonly
FOREIGN_IMPORT_SOURCE_DB_PASSWORD=
FOREIGN_IMPORT_SOURCE_ID=laravel-foreign-v1
# Set to the actual timezone of Laravel timestamp-without-time-zone values.
FOREIGN_IMPORT_SOURCE_TIMEZONE=UTC
# Verified old Laravel users.id -> existing identity_users.id, never email guessing.
FOREIGN_IMPORT_USER_MAP={}
