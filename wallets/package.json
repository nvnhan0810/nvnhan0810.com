{
  "name": "wallets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "type-check": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run test && npm run build",
    "preview": "vite preview --host localhost --port 4175 --strictPort",
    "lint": "eslint ."
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "chart.js": "^4.5.1",
    "flatpickr": "^4.6.13",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "jsdom": "^30.0.1",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.11"
  }
}
