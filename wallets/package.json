{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "typecheck": "vue-tsc --noEmit -p tsconfig.json",
        "typecheck:all": "vue-tsc --noEmit -p tsconfig.app.json",
        "test:frontend": "vitest run",
        "test:frontend:watch": "vitest"
    },
    "devDependencies": {
        "@types/node": "^26.4.0",
        "@types/sortablejs": "^1.15.9",
        "@vue/test-utils": "^2.5.0",
        "@vue/tsconfig": "^0.9.1",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "jsdom": "^30.0.1",
        "path": "^0.12.7",
        "typescript": "~5.9.0",
        "vitest": "^4.1.11",
        "vue-tsc": "^3.3.11"
    },
    "allowScripts": {
        "esbuild@0.27.7": true
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.6.1",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "chart.js": "^4.5.1",
        "flatpickr": "^4.6.13",
        "laravel-vite-plugin": "^2.0.0",
        "sortablejs": "^1.15.7",
        "tailwindcss": "^4.0.0",
        "vite": "^7.3.6",
        "vue": "^3.5.40"
    }
}
