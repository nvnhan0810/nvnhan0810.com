#!/usr/bin/env bash
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"
declare -A checked=()

while read -r local_ref local_oid remote_ref remote_oid; do
  # Git sends all-zero IDs when deleting a remote ref.
  if [[ "$local_oid" =~ ^0+$ ]]; then continue; fi
  if ! commit=$(git rev-parse --verify "${local_oid}^{commit}" 2>/dev/null); then
    continue # A tag pointing to a blob/tree has no application to build.
  fi
  for project in portfolio backend; do
    key="$project:$commit"
    if [[ -n "${checked[$key]:-}" ]]; then continue; fi
    if [[ ! "$remote_oid" =~ ^0+$ ]] && git cat-file -e "${remote_oid}^{commit}" 2>/dev/null; then
      if git diff --quiet "${remote_oid}^{commit}" "$commit" -- "$project/" .githooks/; then
        continue
      else
        status=$?
        if [[ "$status" != 1 ]]; then exit "$status"; fi
      fi
    elif [[ -z "$(git ls-tree -d --name-only "$commit" -- "$project")" ]]; then
      continue
    fi
    echo "Checking $project before pushing ${local_ref} to ${remote_ref}"
    "$root/.githooks/check-$project" commit "$commit" </dev/null
    checked[$key]=1
  done
done
