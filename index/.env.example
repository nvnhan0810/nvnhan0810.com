APP_SERVICE=web
APP_NAME="nvnhan0810"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_URL=http://localhost

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily,telegram
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

TELEGRAM_LOG_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_LOG_LEVEL=warning
TELEGRAM_LOG_QUEUE=false
# TELEGRAM_LOG_QUEUE_CONNECTION=redis
# TELEGRAM_LOG_QUEUE_NAME=default

DB_CONNECTION=pgsql
DB_HOST=docker.host.internal
DB_PORT=5432
DB_DATABASE=nvnhan0810
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis — external service (not in app pod). Survives pod rebuilds.
# Production: point REDIS_HOST at your Redis Service / managed Redis.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
# REDIS_QUEUE_CONNECTION=default
# REDIS_QUEUE=default

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SEO_SITE_NAME="Nguyen Van Nhan"
SEO_PORTFOLIO_TITLE="Software Developer"
SEO_PORTFOLIO_TAGLINE="Web · Mobile · System Architecture"
SEO_TWITTER_SITE="@nvnhan0810"

# Inertia SSR + queue + scheduler (production Docker: Supervisor chạy inertia-ssr, queue:work, schedule:work)
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714

GOOGLE_CLIENT_ID={GOOGLE_CLIENT_ID}
GOOGLE_CLIENT_SECRET={GOOGLE_CLIENT_SECRET}
GOOGLE_REDIRECT_URL=https://nvnhan0810.com/auth/callback
GOOGLE_ANALYTICS_MEASUREMENT_ID=

# Reading Digest
DIGEST_NOTIFICATION_TIME=07:00
DIGEST_TIMEZONE=Asia/Ho_Chi_Minh
DIGEST_ARTICLES_PER_SUBJECT=5
# Per-source fetch: clamp(demand * multiplier, min, max); demand = sum(enabled subjects' articles_per_digest)
DIGEST_FETCH_LIMIT_PER_SOURCE=15
DIGEST_FETCH_LIMIT_MIN=5
DIGEST_FETCH_DEMAND_MULTIPLIER=3
DIGEST_FETCH_SINCE_HOURS=24
DIGEST_TELEGRAM_ENABLED=false
DIGEST_TELEGRAM_BOT_TOKEN=
DIGEST_TELEGRAM_CHAT_ID=
# Self-hosted AI (ai-embedding-enrichment) — enrich + embed
DIGEST_AI_BASE_URL=https://ai.nvnhan0810.com
DIGEST_AI_API_KEY=
DIGEST_AI_TIMEOUT=60
DIGEST_ENRICH_ONLY_FETCHED_TODAY=true
DIGEST_ENRICH_BATCH_SIZE=10
# Optional: Gemini only for digest ranking
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
DIGEST_RANKING_MODEL=gemini-2.5-flash
# Post Agent + Cursor Cloud Agents (admin chat khi tạo/sửa bài — riêng Reading Digest)
CURSOR_API_KEY=
POST_AGENT_MODEL=auto
POST_AGENT_TIMEOUT=120

# Central SSO (Google OAuth chỉ trên index; wallets/flc/todo là client trên subdomain riêng)
# Một SSO_SECRET dùng chung. Redirect URI = SSO_WALLETS_URL / SSO_FLC_URL / SSO_TODO_URL.
SSO_SECRET=
SSO_CODE_TTL_SECONDS=120
SSO_WALLETS_URL=https://wallets.nvnhan0810.com
SSO_FLC_URL=https://foreign.nvnhan0810.com
SSO_TODO_URL=https://todo.nvnhan0810.com

# External Todo Matrix link in admin Header (defaults to SSO_TODO_URL)
TODO_APP_URL="${SSO_TODO_URL}"

# Post Agent API (cho Cursor agent local gọi tạo/update/publish)
# Dùng cho endpoint: /api/agent/posts/...
POST_AGENT_API_TOKEN=
# Public HTTPS URL for Telegram Read/Vote buttons (Telegram rejects localhost)
DIGEST_PUBLIC_URL=https://nvnhan0810.com
